extends ../layouts/application

block content
  if isAuthenticated()
    a.btn.btn-primary.mb-3(href=route('newLabel'))= t('views.labels.new.action')

  table.table.table-striped
    thead
      tr
        th= t('views.labels.id')
        th= t('views.labels.name')
        th= t('views.labels.createdAt')
    tbody
      each label in labels
        tr
          td= label.id
          td= label.name
          td= formatDate(label.createdAt)
          td
            if isAuthenticated()
              .d-flex.gap-2
                a.btn.btn-primary(href=route('editLabel', { id: label.id }))= t('views.labels.edit.action')
                +buttonTo(
                  route('deleteLabel', { id: label.id }),
                  'DELETE',
                  'btn btn-danger',
                  t('views.labels.delete.action')
                )