extends ../layouts/application

block content
  if isAuthenticated()
    a.btn.btn-primary.mb-3(href=route('newStatus'))= t('views.statuses.new.action')

  table.table.table-striped
    thead
      tr
        th= t('views.statuses.id')
        th= t('views.statuses.name')
        th= t('views.statuses.createdAt')
        th= t('views.statuses.actions')
    tbody
      each status in statuses
        tr
          td= status.id
          td= status.name
          td= formatDate(status.createdAt)
          td
            if isAuthenticated()
              .d-flex.gap-2
                a.btn.btn-primary(href=route('editStatus', { id: status.id }))= t('views.statuses.edit.action')
                +buttonTo(
                  route('deleteStatus', { id: status.id }),
                  'DELETE',
                  'btn btn-danger',
                  t('views.statuses.delete.action')
                )