extends ../layouts/application

include ../mixins/buttonTo

block content
  table.table.table-striped
    thead
      tr
        th= t('views.users.id')
        th= t('views.users.fullName')
        th= t('views.users.email')
        th= t('views.users.createdAt')
        th= t('views.users.actions')
    tbody
      each user in users
        tr
          td= user.id
          td= `${user.firstName} ${user.lastName}`
          td= user.email
          td= formatDate(user.createdAt)
          td
            if isAuthenticated() && reply.request.user.id === user.id
              .d-flex
                a.btn.btn-primary(
                  href=route('editUser', { id: String(user.id) })
                )= t('views.users.edit.action')

                +buttonTo(
                  route('deleteUser', { id: String(user.id) }),
                  'DELETE',
                  'btn btn-danger',
                  t('views.users.delete.action')
                )