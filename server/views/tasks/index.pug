extends ../layouts/application.pug

block content
  .container.mt-4
    if isAuthenticated()
      a.btn.btn-primary.mb-3(href=route('newTask'))= t('views.tasks.new.header')

    form.card.card-body.mb-4(action=route('tasks'), method='get')
      .row.g-3
        .col-md-4
          .input-group
            label.input-group-text(for='status')= t('views.tasks.filters.status')
            select.form-select(id='status', name='status')
              option(value='', selected=filters.status === '')
              each status in statuses
                option(
                  value=status.id
                  selected=String(status.id) === filters.status
                )= status.name

        .col-md-4
          .input-group
            label.input-group-text(for='executor')= t('views.tasks.filters.executor')
            select.form-select(id='executor', name='executor')
              option(value='', selected=filters.executor === '')
              each user in users
                option(
                  value=user.id
                  selected=String(user.id) === filters.executor
                )= `${user.firstName} ${user.lastName}`

        .col-md-4
          .input-group
            label.input-group-text(for='label')= t('views.tasks.filters.label')
            select.form-select(id='label', name='label')
              option(value='', selected=filters.label === '')
              each label in labels
                option(
                  value=label.id
                  selected=String(label.id) === filters.label
                )= label.name

      if isAuthenticated()
        .form-check.mt-3
          input.form-check-input(
            type='checkbox'
            id='isCreatorUser'
            name='isCreatorUser'
            value='1'
            checked=filters.isCreatorUser
          )
          label.form-check-label(for='isCreatorUser')= t('views.tasks.filters.own')


      .mt-3
        button.btn.btn-primary(type='submit')= t('views.tasks.filters.show')

    table.table
      thead
        tr
          th ID
          th= t('views.tasks.name')
          th= t('views.tasks.status')
          th= t('views.tasks.creator')
          th= t('views.tasks.executor')
          th= t('views.statuses.createdAt')
          th

      tbody
        each task in tasks
          tr
            td= task.id
            td
              a(href=route('task', { id: task.id }))= task.name
            td= task.status.name
            td= `${task.creator.firstName} ${task.creator.lastName}`
            td= task.executor ? `${task.executor.firstName} ${task.executor.lastName}` : ''
            td= task.createdAt
            td
              if isAuthenticated()
                .d-flex.gap-2
                  a.btn.btn-primary.btn-sm(
                      href=route('editTask', { id: task.id })
                  )= t('views.tasks.edit.action')

                  +buttonTo(
                    route('task', { id: task.id }),
                    'DELETE',
                    'btn btn-danger btn-sm',
                    t('views.tasks.delete.action')
                  )
