extends ../layouts/application.pug

block content
  .container.mt-4
    h1= task.name

    p
      strong= `${t('views.tasks.status')}: `
      = task.status.name

    p
      strong= `${t('views.tasks.creator')}: `
      = `${task.creator.firstName} ${task.creator.lastName}`

    if task.executor
      p
        strong= `${t('views.tasks.executor')}: `
        = `${task.executor.firstName} ${task.executor.lastName}`

    if task.labels.length
      p
        strong= `${t('views.tasks.labels')}: `
        = task.labels.map((label) => label.name).join(', ')

    if task.description
      p= task.description

    if isAuthenticated()
      a.btn.btn-primary(
        href=route('editTask', { id: task.id })
      )= t('views.tasks.edit.action')