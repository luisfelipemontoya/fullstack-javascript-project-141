extends ../layouts/application.pug

block content
  .container.mt-4
    h1= task.name

    p
      strong= `${t('views.tasks.status')}: `
      = task.status.name

    p
      strong= `${t('views.tasks.creator')}: `
      = `${task.creator.firstName} ${task.creator.lastName}`

    if task.executor
      p
        strong= `${t('views.tasks.executor')}: `
        = `${task.executor.firstName} ${task.executor.lastName}`

    if task.description
      p= task.description