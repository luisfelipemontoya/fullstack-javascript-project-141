extends ../layouts/application

block content
  .container.col-xxl-8.px-4.py-5
    .row.flex-lg-row-reverse.align-items-center.g-5.py-5
      .col-10.col-sm-8.col-lg-6
        img.d-block.mx-lg-auto.img-fluid(
          src="https://getbootstrap.com/docs/5.3/examples/heroes/bootstrap-themes.png"
          alt=t('views.welcome.index.imageAlt')
          width="700"
          height="500"
          loading="lazy"
        )

      .col-lg-6
        h1.display-5.fw-bold.lh-1.mb-3= t('views.welcome.index.hello')
        p.lead= t('views.welcome.index.description')

        .d-grid.gap-2.d-md-flex.justify-content-md-start
          a.btn.btn-primary.btn-lg.px-4.me-md-2(
            href=route('newUser')
          )= t('views.welcome.index.signUp')

          a.btn.btn-outline-secondary.btn-lg.px-4(
            href=route('newSession')
          )= t('views.welcome.index.signIn')